<span class="{{class "badge" .Variant "neutral" .Size "md" .Class}}" {#if id}id="{id}"{/if} data-kiw-component="Badge">
  {#if dot}<span class="badge-dot" aria-hidden="true"></span>{/if}
  <span class="badge-text">{#if body}{body}{:else if text}{text}{:else}{label}{/if}</span>
</span>

<style>
.badge {
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  font-weight: 800;
  border-radius: 999px;
  border: 1.5px solid var(--border, #1c1917);
  box-shadow: 1.5px 1.5px 0px var(--border, #1c1917);
  line-height: 1;
  white-space: nowrap;
  letter-spacing: 0.02em;
}
.badge-sm { padding: 0.15rem 0.45rem; font-size: 0.7rem; }
.badge-md { padding: 0.25rem 0.65rem; font-size: 0.78rem; }

.badge-neutral {
  background: var(--bg-2, #f0ede5);
  color: var(--fg, #1c1917);
}
.badge-primary {
  background: var(--primary, #10b981);
  color: var(--primary-content, #1c1917);
}
.badge-secondary {
  background: var(--secondary, #00D1C1);
  color: var(--secondary-content, #1c1917);
}
.badge-accent {
  background: var(--accent, #FF3B2E);
  color: #ffffff;
}
.badge-success {
  background: var(--success, #10b981);
  color: var(--primary-content, #1c1917);
}
.badge-warning {
  background: var(--warning, #ffb703);
  color: #1c1917;
}
.badge-error {
  background: var(--error, #FF3B2E);
  color: #ffffff;
}

.badge-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: currentColor;
  display: inline-block;
}
</style>
