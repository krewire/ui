<label class="kiw-checkbox-label {class}" class:is-disabled={disabled} {#if id}id="{id}-label"{/if} data-kiw-component="Checkbox">
  <input
    type="checkbox"
    name="{name}"
    {#if id}id="{id}"{/if}
    {#if value}value="{value}"{/if}
    {#if checked}checked{/if}
    {#if required}required{/if}
    {#if disabled}disabled{/if}
    class="kiw-checkbox-input"
  >
  <span class="kiw-checkbox-box" aria-hidden="true">
    <svg class="kiw-checkbox-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="3.5 8.5 6.5 11.5 12.5 4.5"></polyline>
    </svg>
  </span>
  <span class="kiw-checkbox-text">{#if body}{body}{:else}{label}{/if}</span>
</label>

<style>
.kiw-checkbox-label {
  display: inline-flex;
  align-items: center;
  gap: 0.6rem;
  font-size: 0.9rem;
  font-weight: 600;
  color: var(--fg, #1c1917);
  cursor: pointer;
  user-select: none;
}
.kiw-checkbox-label.is-disabled {
  opacity: 0.6;
  cursor: not-allowed;
}
.kiw-checkbox-input {
  position: absolute;
  opacity: 0;
  width: 0;
  height: 0;
  margin: 0;
}
.kiw-checkbox-box {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 1.25rem;
  height: 1.25rem;
  border-radius: var(--radius-sm, 5px);
  border: var(--pop-border-thin, 1px solid var(--border, #e2ded4));
  background: var(--bg, #fafaf9);
  box-shadow: var(--pop-shadow-sm, 0 1px 2px 0 rgba(0, 0, 0, 0.05));
  transition: background-color 0.15s ease, transform 0.1s ease;
  flex-shrink: 0;
}
.kiw-checkbox-icon {
  width: 0.85rem;
  height: 0.85rem;
  color: var(--primary-content, #1c1917);
  display: none;
}
.kiw-checkbox-input:checked + .kiw-checkbox-box {
  background: var(--primary, #10b981);
}
.kiw-checkbox-input:checked + .kiw-checkbox-box .kiw-checkbox-icon {
  display: block;
}
.kiw-checkbox-input:focus-visible + .kiw-checkbox-box {
  outline: 2px solid var(--primary, #10b981);
  outline-offset: 2px;
}
</style>
