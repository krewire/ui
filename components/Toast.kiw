<div class="{{class "toast" .Variant "info" .Position "bottom-right" .Class}}" data-kiw-component="Toast" role="status" aria-live="polite" {#if id}id="{id}"{/if}>
  <div class="toast-indicator"></div>
  <div class="toast-icon">
    {#if icon}
      {icon}
    {:else}
      {#if variant == "success"}✓
      {:else if variant == "warning"}⚠
      {:else if variant == "error"}✕
      {:else}ℹ{/if}
    {/if}
  </div>
  <div class="toast-body">
    {#if title}<div class="toast-title">{title}</div>{/if}
    <div class="toast-message">{#if message}{message}{:else if body}{body}{/if}</div>
  </div>
  {#if dismissible != false}
  <button type="button" class="toast-close" aria-label="Close notification" onclick="this.closest('.toast').remove()">✕</button>
  {/if}
</div>

<style>
.toast {
  display: inline-flex;
  align-items: center;
  gap: 0.75rem;
  padding: 0.75rem 1rem;
  background: var(--bg, #FAF8F4);
  color: var(--fg, #0B1F3B);
  border-radius: var(--radius, 10px);
  border: var(--pop-border-thin, 2px solid var(--border, #0B1F3B));
  box-shadow: var(--pop-shadow, 4px 4px 0px var(--border, #0B1F3B));
  position: relative;
  overflow: hidden;
  min-width: 18rem;
  max-width: 28rem;
  box-sizing: border-box;
  animation: toastSlideIn 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  z-index: var(--ui-z-toast, 1600);
}

.toast-indicator {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 5px;
  background: currentColor;
}

.toast-icon {
  display: grid;
  place-items: center;
  width: 1.75rem;
  height: 1.75rem;
  border-radius: 50%;
  font-weight: 900;
  font-size: 0.85rem;
  flex-shrink: 0;
  border: 1.5px solid currentColor;
}

.toast-body {
  flex: 1 1 auto;
  min-width: 0;
}

.toast-title {
  font-size: 0.85rem;
  font-weight: 800;
  letter-spacing: -0.01em;
  margin-bottom: 0.15rem;
  line-height: 1.25;
}

.toast-message {
  font-size: 0.78rem;
  color: var(--fg-muted, #57677d);
  line-height: 1.4;
}

.toast-close {
  background: transparent;
  border: 1.5px solid transparent;
  border-radius: 4px;
  width: 1.5rem;
  height: 1.5rem;
  display: grid;
  place-items: center;
  font-size: 0.75rem;
  font-weight: 800;
  color: var(--fg-muted, #57677d);
  cursor: pointer;
  flex-shrink: 0;
  transition: all 0.12s ease;
}
.toast-close:hover {
  background: var(--bg-2, #f2ede4);
  color: var(--fg, #0B1F3B);
  border-color: var(--border, #0B1F3B);
}

/* Variants */
.toast-success { color: #0d7328; }
.toast-success .toast-indicator { background: var(--success, #39D353); }
.toast-success .toast-icon { background: var(--success, #39D353); color: #0B1F3B; border-color: var(--border, #0B1F3B); }

.toast-info { color: #00877c; }
.toast-info .toast-indicator { background: var(--info, #00D1C1); }
.toast-info .toast-icon { background: var(--info, #00D1C1); color: #0B1F3B; border-color: var(--border, #0B1F3B); }

.toast-warning { color: #9c5c00; }
.toast-warning .toast-indicator { background: var(--warning, #ffb703); }
.toast-warning .toast-icon { background: var(--warning, #ffb703); color: #0B1F3B; border-color: var(--border, #0B1F3B); }

.toast-error { color: var(--error, #FF3B2E); }
.toast-error .toast-indicator { background: var(--error, #FF3B2E); }
.toast-error .toast-icon { background: var(--error, #FF3B2E); color: #ffffff; border-color: var(--border, #0B1F3B); }

/* Dark mode adjustments */
html.dark .toast, [data-theme="dark"] .toast, .dark .toast {
  background: var(--bg, #0B1F3B);
  color: var(--fg, #FAF8F4);
  border-color: var(--border, #FAF8F4);
  box-shadow: 4px 4px 0px #39D353;
}
html.dark .toast-message, [data-theme="dark"] .toast-message, .dark .toast-message {
  color: var(--fg-muted, #9ab0ce);
}
html.dark .toast-close:hover, [data-theme="dark"] .toast-close:hover, .dark .toast-close:hover {
  background: var(--bg-2, #112646);
  color: var(--fg, #FAF8F4);
  border-color: var(--border, #FAF8F4);
}

@keyframes toastSlideIn {
  from {
    transform: translateY(10px) scale(0.96);
    opacity: 0;
  }
  to {
    transform: translateY(0) scale(1);
    opacity: 1;
  }
}
</style>
