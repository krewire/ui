<button
  type="button"
  class="hamburger {#if class}{class}{:else if Class}{Class}{/if}"
  {#if id}id="{id}"{:else if ID}id="{ID}"{/if}
  aria-label="{#if label}{label}{:else if Label}{Label}{:else}Toggle navigation{/if}"
  aria-expanded="{#if expanded}{expanded}{:else if Expanded}{Expanded}{:else}false{/if}"
  {#if controls}aria-controls="{controls}"{:else if Controls}aria-controls="{Controls}"{/if}
  {#if dataDrawerToggle}data-drawer-toggle="{dataDrawerToggle}"{:else if DataDrawerToggle}data-drawer-toggle="{DataDrawerToggle}"{:else if controls}data-drawer-toggle="{controls}"{:else if Controls}data-drawer-toggle="{Controls}"{/if}
  data-kiw-component="Hamburger">
  <span class="hamburger-box" aria-hidden="true">
    <span class="hamburger-line line-1"></span>
    <span class="hamburger-line line-2"></span>
    <span class="hamburger-line line-3"></span>
  </span>
</button>

<style>
.hamburger {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 2.25rem;
  height: 2.25rem;
  min-width: 2.25rem;
  min-height: 2.25rem;
  padding: 0;
  border-radius: var(--radius-sm, var(--radius, 6px));
  border: var(--pop-border-thin, 1px solid var(--border, #e7e5e4));
  background: var(--bg, #fafaf9);
  color: var(--fg, #1c1917);
  cursor: pointer;
  box-shadow: var(--pop-shadow-sm, 0 1px 2px 0 rgba(0, 0, 0, 0.05));
  transition: transform 0.15s ease, box-shadow 0.15s ease, background-color 0.15s ease;
  user-select: none;
}
.hamburger.hidden {
  display: none !important;
}
@media (min-width: 1024px) {
  .hamburger.lg\:hidden {
    display: none !important;
  }
}
@media (min-width: 768px) {
  .hamburger.md\:hidden {
    display: none !important;
  }
}
.hamburger:hover {
  background: var(--bg-2, #f2ede4);
  transform: translateY(-1px);
  box-shadow: 3px 3px 0px var(--border, #1c1917);
}
.hamburger:active {
  transform: translate(1px, 1px);
  box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.04);
}
.hamburger-box {
  position: relative;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  flex-shrink: 0;
  width: 1.125rem;
  height: 0.875rem;
}
.hamburger-line {
  display: block;
  width: 100%;
  height: 2px;
  min-height: 2px;
  background-color: var(--fg, currentColor);
  border-radius: 1px;
  transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1),
              opacity 0.2s ease-in-out;
  transform-origin: center;
}

/* Morphing animation to 'X' */
.hamburger[aria-expanded="true"] .line-1,
.hamburger.is-active .line-1 {
  transform: translateY(6px) rotate(45deg);
}
.hamburger[aria-expanded="true"] .line-2,
.hamburger.is-active .line-2 {
  opacity: 0;
  transform: scaleX(0);
}
.hamburger[aria-expanded="true"] .line-3,
.hamburger.is-active .line-3 {
  transform: translateY(-6px) rotate(-45deg);
}

html[data-theme="dark"] .hamburger,
.dark .hamburger {
  background: var(--bg-dark, #071426);
  color: var(--fg-dark, #fafaf9);
  border-color: var(--border-dark, #fafaf9);
  box-shadow: 2px 2px 0px var(--border-dark, #fafaf9);
}
html[data-theme="dark"] .hamburger:hover,
.dark .hamburger:hover {
  background: var(--bg-dark-2, #0d223f);
  box-shadow: 3px 3px 0px var(--border-dark, #fafaf9);
}
</style>
