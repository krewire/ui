<div class="accordion {class}" data-kiw-component="Accordion">
  {#if body}
    {body}
  {:else if items}
    {#each items as item}
      <details class="accordion-item" {#if item.open}open{/if}>
        <summary class="accordion-header">
          <span class="accordion-title">{item.title}</span>
          <svg class="accordion-chevron" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M4 6l4 4 4-4" />
          </svg>
        </summary>
        <div class="accordion-body">
          <div class="accordion-content">{item.content}</div>
        </div>
      </details>
    {/each}
  {/if}
</div>

<style>
.accordion {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  width: 100%;
  box-sizing: border-box;
}

.accordion-item {
  border-radius: var(--radius, 10px);
  border: var(--pop-border-thin, 2px solid var(--border, #0B1F3B));
  background: var(--bg, #FAF8F4);
  box-shadow: var(--pop-shadow-sm, 2px 2px 0px var(--border, #0B1F3B));
  overflow: hidden;
  transition: box-shadow 0.12s ease;
}
.accordion-item[open] {
  box-shadow: var(--pop-shadow, 4px 4px 0px var(--border, #0B1F3B));
}

.accordion-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0.85rem 1.15rem;
  font-size: 0.92rem;
  font-weight: 800;
  color: var(--fg, #0B1F3B);
  cursor: pointer;
  user-select: none;
  list-style: none;
  background: var(--bg-2, #f2ede4);
  transition: background-color 0.12s ease;
}
.accordion-header::-webkit-details-marker,
.accordion-header::marker {
  display: none !important;
}
.accordion-header:hover {
  background: rgba(57, 211, 83, 0.15);
  color: var(--fg, #0B1F3B);
}

.accordion-chevron {
  width: 1rem;
  height: 1rem;
  transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  flex-shrink: 0;
}
.accordion-item[open] .accordion-chevron {
  transform: rotate(180deg);
}

.accordion-body {
  padding: 1rem 1.15rem;
  background: var(--bg, #FAF8F4);
  border-top: 1.5px solid var(--border-subtle, rgba(11, 31, 59, 0.15));
}

.accordion-content {
  font-size: 0.85rem;
  color: var(--fg-muted, #57677d);
  line-height: 1.6;
}

html.dark .accordion-item, [data-theme="dark"] .accordion-item, .dark .accordion-item {
  background: var(--bg, #0B1F3B);
  border-color: var(--border, #FAF8F4);
  box-shadow: 2px 2px 0px #39D353;
}
html.dark .accordion-item[open], [data-theme="dark"] .accordion-item[open], .dark .accordion-item[open] {
  box-shadow: 4px 4px 0px #39D353;
}
html.dark .accordion-header, [data-theme="dark"] .accordion-header, .dark .accordion-header {
  background: var(--bg-2, #112646);
  color: var(--fg, #FAF8F4);
}
html.dark .accordion-header:hover, [data-theme="dark"] .accordion-header:hover, .dark .accordion-header:hover {
  background: rgba(57, 211, 83, 0.2);
}
html.dark .accordion-body, [data-theme="dark"] .accordion-body, .dark .accordion-body {
  background: var(--bg, #0B1F3B);
  border-top-color: var(--border-subtle, rgba(250, 248, 244, 0.15));
}
html.dark .accordion-content, [data-theme="dark"] .accordion-content, .dark .accordion-content {
  color: var(--fg-muted, #9ab0ce);
}
</style>
