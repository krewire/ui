{#if href}
<a href="{href}" class="{{class "card" .Variant "default" .Class}} card-clickable" {#if id}id="{id}"{/if} {#if target}target="{target}" rel="noopener"{/if} data-kiw-component="Card">
  {#if media}
  <div class="card-media">{media}</div>
  {:else if image}
  <div class="card-media">{image}</div>
  {/if}
  {#if header}
    {header}
  {:else if head}
    {head}
  {:else if title || badge}
  <div class="card-head">
    <div class="card-titles">
      {#if title}<h3 class="card-title">{title}</h3>{/if}
      {#if subtitle}<p class="card-subtitle">{subtitle}</p>{/if}
    </div>
    {#if badge}
    <span class="card-badge">{badge}</span>
    {/if}
    {#if actions}
    <div class="card-actions">{actions}</div>
    {/if}
  </div>
  {/if}
  {#if body}
  <div class="card-body">{body}</div>
  {/if}
  {#if footer}
  <div class="card-footer">{footer}</div>
  {/if}
</a>
{:else}
<div class="{{class "card" .Variant "default" .Class}}" {#if id}id="{id}"{/if} data-kiw-component="Card">
  {#if media}
  <div class="card-media">{media}</div>
  {:else if image}
  <div class="card-media">{image}</div>
  {/if}
  {#if header}
    {header}
  {:else if head}
    {head}
  {:else if title || badge}
  <div class="card-head">
    <div class="card-titles">
      {#if title}<h3 class="card-title">{title}</h3>{/if}
      {#if subtitle}<p class="card-subtitle">{subtitle}</p>{/if}
    </div>
    {#if badge}
    <span class="card-badge">{badge}</span>
    {/if}
    {#if actions}
    <div class="card-actions">{actions}</div>
    {/if}
  </div>
  {/if}
  {#if body}
  <div class="card-body">{body}</div>
  {/if}
  {#if footer}
  <div class="card-footer">{footer}</div>
  {/if}
</div>
{/if}

<style>
.card {
  --card-px: 1.125rem;
  --card-py: 1rem;
  --card-gap: 0.65rem;
  background: var(--bg, #fafaf9);
  border: var(--pop-border, 1px solid var(--border, #e7e5e4));
  border-radius: var(--radius, 14px);
  box-shadow: var(--pop-shadow, 0 1px 3px 0 rgba(0, 0, 0, 0.08), 0 1px 2px -1px rgba(0, 0, 0, 0.05));
  padding: var(--card-py) var(--card-px);
  display: flex;
  flex-direction: column;
  gap: var(--card-gap);
  box-sizing: border-box;
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}
@media (min-width: 640px) {
  .card {
    --card-px: 1.35rem;
    --card-py: 1.25rem;
    --card-gap: 0.75rem;
  }
}
@media (min-width: 1024px) {
  .card {
    --card-px: 1.6rem;
    --card-py: 1.35rem;
    --card-gap: 0.85rem;
  }
}
.card:hover {
  transform: translateY(-1px);
  box-shadow: var(--pop-shadow-lg, 0 10px 15px -3px rgba(0, 0, 0, 0.08), 0 4px 6px -4px rgba(0, 0, 0, 0.03));
}
.card-clickable {
  text-decoration: none;
  color: inherit;
  cursor: pointer;
}
.card-featured {
  background: var(--bg-2, #f0ede5);
  border-color: var(--primary, #10b981);
  box-shadow: 5px 5px 0px var(--border, #1c1917);
}
.card-primary {
  background: var(--primary, #10b981);
  color: var(--primary-content, #1c1917);
  border-color: var(--border, #1c1917);
}
.card-subtle {
  background: var(--bg, #fafaf9);
  border: 1.5px solid var(--border, #1c1917);
  box-shadow: var(--pop-shadow-sm, 0 1px 2px 0 rgba(0, 0, 0, 0.04));
}

.card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 1rem;
}
.card-titles {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
  flex: 1;
}
.card-title {
  margin: 0;
  font-size: 1.15rem;
  font-weight: 800;
  letter-spacing: -0.01em;
  color: inherit;
}
.card-subtitle {
  margin: 0;
  font-size: 0.85rem;
  color: var(--muted, #57677d);
  font-weight: 500;
}
.card-badge {
  font-size: 0.75rem;
  font-weight: 700;
  padding: 0.2rem 0.55rem;
  background: var(--bg-2, #f0ede5);
  border: 1.5px solid var(--border, #1c1917);
  border-radius: 999px;
  align-self: flex-start;
}
.card-body {
  font-size: 0.92rem;
  line-height: 1.55;
  color: inherit;
}
.card-media {
  margin: calc(-1 * var(--card-py)) calc(-1 * var(--card-px)) 0.5rem;
  border-top-left-radius: calc(var(--radius, 14px) - 2.5px);
  border-top-right-radius: calc(var(--radius, 14px) - 2.5px);
  overflow: hidden;
  border-bottom: var(--pop-border, 1px solid var(--border, #e7e5e4));
}
.card-media img {
  width: 100%;
  height: auto;
  display: block;
}
.card-footer {
  margin-top: auto;
  padding-top: 0.5rem;
  border-top: 1.5px solid var(--border-subtle, rgba(11, 31, 59, 0.12));
  font-size: 0.85rem;
}

html[data-theme="dark"] .card,
.dark .card {
  background: var(--bg-dark, #071426);
  border-color: var(--border-dark, #fafaf9);
  box-shadow: 4px 4px 0px var(--border-dark, #fafaf9);
  color: var(--fg-dark, #fafaf9);
}
html[data-theme="dark"] .card-featured,
.dark .card-featured {
  background: var(--bg-dark-2, #0d223f);
  border-color: var(--primary, #10b981);
}
</style>
