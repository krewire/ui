{#if src}
<img class="kiw-avatar {#if size}kiw-avatar-{size}{:else}kiw-avatar-md{/if} {#if shape}kiw-avatar-{shape}{:else}kiw-avatar-circle{/if} {class}"
     src="{src}"
     alt="{alt}"
     {#if id}id="{id}"{/if}
     loading="lazy"
     decoding="async"
     data-kiw-component="Avatar">
{:else}
<span class="kiw-avatar kiw-avatar-{#if size}{size}{:else}md{/if} kiw-avatar-{#if shape}{shape}{:else}circle{/if} kiw-avatar-initials {class}"
      {#if id}id="{id}"{/if}
      {#if alt}role="img" aria-label="{alt}"{:else}aria-hidden="true"{/if}
      data-kiw-component="Avatar">{#if body}{body}{:else}{initials}{/if}</span>
{/if}

<style>
.kiw-avatar {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  flex-shrink: 0;
  overflow: hidden;
  object-fit: cover;
  background: var(--primary, #10b981);
  color: var(--primary-content, #1c1917);
  font-family: var(--ui-font-mono, ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace);
  font-weight: 800;
  text-transform: uppercase;
  user-select: none;
}
.kiw-avatar-circle { border-radius: 50%; }
.kiw-avatar-square { border-radius: var(--radius, 10px); }
.kiw-avatar-xs { width: 1.5rem; height: 1.5rem; font-size: 0.6rem; }
.kiw-avatar-sm { width: 2rem; height: 2rem; font-size: 0.75rem; }
.kiw-avatar-md { width: 2.75rem; height: 2.75rem; font-size: 0.95rem; }
.kiw-avatar-lg { width: 3.5rem; height: 3.5rem; font-size: 1.2rem; }
.kiw-avatar-xl { width: 5rem; height: 5rem; font-size: 1.75rem; }

/* An initials avatar with no image needs a border to match the pop style; an
   <img> carries its own, and a border would double up on the source. */
.kiw-avatar-initials {
  border: var(--pop-border-thin, 1px solid var(--border, #e2ded4));
  box-shadow: var(--pop-shadow-sm, 0 1px 2px 0 rgba(0, 0, 0, 0.05));
}
</style>