<button type="button"
        class="theme-switch btn w-9 h-9 p-0 min-h-0 text-base flex items-center justify-center rounded-full {class}"
        {#if id}id="{id}"{/if}
        data-theme-toggle
        aria-label="{#if label}{label}{:else}Toggle theme{/if}"
        data-kiw-component="ThemeSwitch">
  <span class="sun sun-icon" aria-hidden="true">☀</span>
  <span class="moon moon-icon" aria-hidden="true">☾</span>
</button>

<style>
.sun-icon { display: var(--show-sun, inline); }
.moon-icon { display: var(--show-moon, none); }
html[data-theme="dark"] .sun-icon,
.dark .sun-icon {
  display: none !important;
}
html[data-theme="dark"] .moon-icon,
.dark .moon-icon {
  display: inline !important;
}
</style>
