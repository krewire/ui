<div class="slider-wrap {class}" data-kiw-component="Slider">
  {#if label}
  <div class="slider-head">
    <label class="slider-label" {#if id}for="{id}"{/if}>{label}</label>
    {#if showValue}
      <span class="slider-badge">{#if value}{value}{:else}50{/if}</span>
    {/if}
  </div>
  {/if}
  <div class="slider-track-wrap">
    <input
      type="range"
      name="{name}"
      {#if id}id="{id}"{/if}
      min="{#if min}{min}{:else}0{/if}"
      max="{#if max}{max}{:else}100{/if}"
      step="{#if step}{step}{:else}1{/if}"
      value="{#if value}{value}{:else}50{/if}"
      class="slider-input"
      {#if disabled}disabled{/if}
      {#if onInput}oninput="{onInput}"{/if}
    />
  </div>
</div>

<style>
.slider-wrap {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  width: 100%;
  box-sizing: border-box;
}

.slider-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.5rem;
}

.slider-label {
  font-size: 0.85rem;
  font-weight: 800;
  color: var(--fg, #0B1F3B);
}

.slider-badge {
  font-family: var(--ui-font-mono, monospace);
  font-size: 0.75rem;
  font-weight: 800;
  padding: 0.1rem 0.4rem;
  border-radius: 4px;
  background: var(--primary, #39D353);
  color: var(--primary-content, #0B1F3B);
  border: 1px solid var(--border, #0B1F3B);
}

.slider-track-wrap {
  display: flex;
  align-items: center;
  width: 100%;
}

.slider-input {
  -webkit-appearance: none;
  appearance: none;
  width: 100%;
  height: 0.65rem;
  background: var(--bg-2, #f2ede4);
  border-radius: 999px;
  border: 1.5px solid var(--border, #0B1F3B);
  outline: none;
  cursor: pointer;
}

.slider-input::-webkit-slider-thumb {
  -webkit-appearance: none;
  appearance: none;
  width: 1.25rem;
  height: 1.25rem;
  border-radius: 50%;
  background: var(--primary, #39D353);
  border: 2px solid var(--border, #0B1F3B);
  box-shadow: 1.5px 1.5px 0px var(--border, #0B1F3B);
  cursor: pointer;
  transition: transform 0.1s ease;
}
.slider-input::-webkit-slider-thumb:hover {
  transform: scale(1.15);
}

.slider-input::-moz-range-thumb {
  width: 1.25rem;
  height: 1.25rem;
  border-radius: 50%;
  background: var(--primary, #39D353);
  border: 2px solid var(--border, #0B1F3B);
  box-shadow: 1.5px 1.5px 0px var(--border, #0B1F3B);
  cursor: pointer;
}

html.dark .slider-label, [data-theme="dark"] .slider-label, .dark .slider-label {
  color: var(--fg, #FAF8F4);
}
html.dark .slider-input, [data-theme="dark"] .slider-input, .dark .slider-input {
  background: var(--bg-2, #112646);
  border-color: var(--border, #FAF8F4);
}
html.dark .slider-input::-webkit-slider-thumb, [data-theme="dark"] .slider-input::-webkit-slider-thumb, .dark .slider-input::-webkit-slider-thumb {
  border-color: var(--border, #FAF8F4);
  box-shadow: 1.5px 1.5px 0px #39D353;
}
</style>
