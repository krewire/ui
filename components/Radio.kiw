<label class="kiw-radio-label {class}" class:is-disabled={disabled} {#if id}id="{id}-label"{/if} data-kiw-component="Radio">
  <input
    type="radio"
    name="{name}"
    {#if id}id="{id}"{/if}
    {#if value}value="{value}"{/if}
    {#if checked}checked{/if}
    {#if required}required{/if}
    {#if disabled}disabled{/if}
    class="kiw-radio-input"
  >
  <span class="kiw-radio-circle" aria-hidden="true">
    <span class="kiw-radio-dot"></span>
  </span>
  <span class="kiw-radio-text">{#if body}{body}{:else}{label}{/if}</span>
</label>

<style>
.kiw-radio-label {
  display: inline-flex;
  align-items: center;
  gap: 0.6rem;
  font-size: 0.9rem;
  font-weight: 600;
  color: var(--fg, #1c1917);
  cursor: pointer;
  user-select: none;
}
.kiw-radio-label.is-disabled {
  opacity: 0.6;
  cursor: not-allowed;
}
.kiw-radio-input {
  position: absolute;
  opacity: 0;
  width: 0;
  height: 0;
  margin: 0;
}
.kiw-radio-circle {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 1.25rem;
  height: 1.25rem;
  border-radius: 50%;
  border: var(--pop-border-thin, 1px solid var(--border, #e7e5e4));
  background: var(--bg, #fafaf9);
  box-shadow: var(--pop-shadow-sm, 0 1px 2px 0 rgba(0, 0, 0, 0.05));
  transition: background-color 0.15s ease;
  flex-shrink: 0;
}
.kiw-radio-dot {
  width: 0.5rem;
  height: 0.5rem;
  border-radius: 50%;
  background: var(--primary-content, #1c1917);
  display: none;
}
.kiw-radio-input:checked + .kiw-radio-circle {
  background: var(--primary, #10b981);
}
.kiw-radio-input:checked + .kiw-radio-circle .kiw-radio-dot {
  display: block;
}
.kiw-radio-input:focus-visible + .kiw-radio-circle {
  outline: 2px solid var(--primary, #10b981);
  outline-offset: 2px;
}
</style>
