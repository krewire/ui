<style>
.dropdown-container.is-open .dropdown-menu {
  display: block !important;
}
.dropdown-container.is-open .dropdown-chevron {
  transform: rotate(180deg) !important;
}
</style>

<script>
function toggleNavDropdown(btn) {
  var container = btn.closest('.dropdown-container');
  if (!container) return;
  var isOpen = container.classList.contains('is-open');
  document.querySelectorAll('.dropdown-container.is-open').forEach(function(el) {
    if (el !== container) {
      el.classList.remove('is-open');
      var b = el.querySelector('.dropdown-trigger');
      if (b) b.setAttribute('aria-expanded', 'false');
    }
  });
  if (isOpen) {
    container.classList.remove('is-open');
    btn.setAttribute('aria-expanded', 'false');
  } else {
    container.classList.add('is-open');
    btn.setAttribute('aria-expanded', 'true');
  }
}
window.toggleNavDropdown = toggleNavDropdown;
if (!window._navDropdownBound) {
  window._navDropdownBound = true;
  document.addEventListener('click', function(e) {
    if (!e.target.closest('.dropdown-container')) {
      document.querySelectorAll('.dropdown-container.is-open').forEach(function(el) {
        el.classList.remove('is-open');
        var b = el.querySelector('.dropdown-trigger');
        if (b) b.setAttribute('aria-expanded', 'false');
      });
    }
  });
}
</script>