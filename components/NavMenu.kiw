<nav class="hidden lg:flex items-center gap-1 ml-auto nav-menu {class}" aria-label="Main Navigation">
  {#if body}
    {body}
  {:else}
    {#if dropdown}
      {dropdown}
    {:else if !hideProducts}
      <!-- Products Dropdown -->
      <details class="relative group dropdown-container">
        <summary class="dropdown-trigger flex items-center gap-1.5 text-sm font-bold text-fg dark:text-fg-dark px-3 py-1.5 rounded-md hover:bg-bg-2 dark:hover:bg-bg-dark-2 hover:text-primary transition-all duration-150 cursor-pointer list-none select-none" aria-haspopup="true">
          <span data-i18n="nav.products">Products</span>
          <svg class="w-3.5 h-3.5 transition-transform duration-150 dropdown-chevron" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6l4 4 4-4"/></svg>
        </summary>
        <div class="dropdown-menu absolute left-0 top-full pt-1.5 z-50">
          <div class="w-72 bg-bg dark:bg-bg-dark p-2 rounded-xl flex flex-col gap-1 border-pop" style="border:var(--pop-border); box-shadow:var(--pop-shadow)">
            <a href="https://dash.krewire.com" target="_blank" rel="noopener" class="flex items-start gap-3 p-2.5 rounded-lg hover:bg-bg-2 dark:hover:bg-bg-dark-2 transition-colors">
              <span class="icon-box bg-primary text-primary-content text-sm shrink-0" style="width:30px;height:30px">⚡</span>
              <div>
                <div class="text-xs font-black text-fg dark:text-fg-dark flex items-center gap-1.5">
                  <span data-i18n="products.workspace_title">Krewire Workspace</span>
                  <span class="text-[9px] badge badge-primary py-0 px-1" data-i18n="nav.badge_ai">AI</span>
                </div>
                <div class="text-[11px] text-muted dark:text-muted-dark leading-snug mt-0.5" data-i18n="nav.workspace_desc">Virtual workspaces &amp; autonomous agents</div>
              </div>
            </a>
            <a href="https://cloud.krewire.com" target="_blank" rel="noopener" class="flex items-start gap-3 p-2.5 rounded-lg hover:bg-bg-2 dark:hover:bg-bg-dark-2 transition-colors">
              <span class="icon-box bg-primary text-primary-content text-sm shrink-0" style="width:30px;height:30px">◈</span>
              <div>
                <div class="text-xs font-black text-fg dark:text-fg-dark flex items-center gap-1.5">
                  <span data-i18n="products.cloud_title">Krewire Cloud</span>
                  <span class="text-[9px] badge badge-primary py-0 px-1" data-i18n="nav.badge_paas">PaaS</span>
                </div>
                <div class="text-[11px] text-muted dark:text-muted-dark leading-snug mt-0.5" data-i18n="nav.cloud_desc">Hybrid PaaS control plane &amp; zero-downtime</div>
              </div>
            </a>
            <a href="https://auth.krewire.com" target="_blank" rel="noopener" class="flex items-start gap-3 p-2.5 rounded-lg hover:bg-bg-2 dark:hover:bg-bg-dark-2 transition-colors">
              <span class="icon-box bg-primary text-primary-content text-sm shrink-0" style="width:30px;height:30px">🛡</span>
              <div>
                <div class="text-xs font-black text-fg dark:text-fg-dark flex items-center gap-1.5">
                  <span data-i18n="products.auth_title">Krewire Auth</span>
                  <span class="text-[9px] badge badge-primary py-0 px-1" data-i18n="nav.badge_id">ID</span>
                </div>
                <div class="text-[11px] text-muted dark:text-muted-dark leading-snug mt-0.5" data-i18n="nav.auth_desc">Multi-tenant SSO, MFA &amp; OIDC identity</div>
              </div>
            </a>
            <a href="https://panel.krewire.com" target="_blank" rel="noopener" class="flex items-start gap-3 p-2.5 rounded-lg hover:bg-bg-2 dark:hover:bg-bg-dark-2 transition-colors">
              <span class="icon-box bg-primary text-primary-content text-sm shrink-0" style="width:30px;height:30px">🎛</span>
              <div>
                <div class="text-xs font-black text-fg dark:text-fg-dark flex items-center gap-1.5">
                  <span data-i18n="products.panel_title">Krewire Panel</span>
                  <span class="text-[9px] badge badge-primary py-0 px-1" data-i18n="nav.badge_host">Host</span>
                </div>
                <div class="text-[11px] text-muted dark:text-muted-dark leading-snug mt-0.5" data-i18n="nav.panel_desc">Self-hosted server &amp; admin control panel</div>
              </div>
            </a>
            <div class="pt-1 mt-1 border-t border-border-subtle">
              <a href="/#products" class="flex items-center justify-between px-2.5 py-1.5 rounded-md text-xs font-bold text-fg dark:text-fg-dark hover:bg-bg-2 dark:hover:bg-bg-dark-2 hover:text-primary transition-colors">
                <span data-i18n="nav.view_all_products">View all Core Products →</span>
              </a>
            </div>
          </div>
        </div>
      </details>
    {/if}

    {#if links}
      {links}
    {:else if !hideLinks}
      <a href="/docs/getting-started" data-i18n="nav.get_started" class="text-sm font-bold text-fg dark:text-fg-dark px-3 py-1.5 rounded-md hover:bg-bg-2 dark:hover:bg-bg-dark-2 hover:text-primary transition-all duration-150">Get Started</a>
      <a href="/docs/getting-started/dsl" data-i18n="nav.dsl" class="text-sm font-bold text-fg dark:text-fg-dark px-3 py-1.5 rounded-md hover:bg-bg-2 dark:hover:bg-bg-dark-2 hover:text-primary transition-all duration-150">DSL</a>
      <a href="/docs" data-i18n="nav.docs" class="text-sm font-bold text-fg dark:text-fg-dark px-3 py-1.5 rounded-md hover:bg-bg-2 dark:hover:bg-bg-dark-2 hover:text-primary transition-all duration-150">Docs</a>
      <a href="/#ecosystem" data-i18n="nav.ecosystem" class="text-sm font-bold text-fg dark:text-fg-dark px-3 py-1.5 rounded-md hover:bg-bg-2 dark:hover:bg-bg-dark-2 hover:text-primary transition-all duration-150">Ecosystem</a>
    {/if}
  {/if}
</nav>

<style>
details.dropdown-container summary::-webkit-details-marker,
details.dropdown-container summary::marker {
  display: none !important;
}
details.dropdown-container summary {
  list-style: none !important;
}
details.dropdown-container:not([open]) .dropdown-menu {
  display: none;
}
details.dropdown-container[open] .dropdown-menu {
  display: block;
}
details.dropdown-container[open] .dropdown-chevron {
  transform: rotate(180deg);
}
@media (hover: hover) and (pointer: fine) {
  details.dropdown-container:hover .dropdown-menu {
    display: block;
  }
  details.dropdown-container:hover .dropdown-chevron {
    transform: rotate(180deg);
  }
}
</style>
