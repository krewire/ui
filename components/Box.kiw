<div class="kiw-box {#if variant}kiw-box-{variant}{/if} {class}"
     class:kiw-box-shadow={shadow}
     class:kiw-box-border={border}
     class:kiw-box-rounded={rounded}
     {#if id}id="{id}"{/if}
     data-kiw-component="Box">
  {body}
</div>

<style>
.kiw-box {
  box-sizing: border-box;
}
.kiw-box-border {
  border: 1px solid var(--border-subtle, var(--border));
}
.kiw-box-rounded {
  border-radius: var(--radius, 10px);
}
.kiw-box-shadow {
  box-shadow: var(--shadow-sm, 0 1px 2px 0 rgba(0, 0, 0, 0.05));
}
.kiw-box-default {
  background: var(--bg, #fafaf9);
  color: var(--fg, #1c1917);
}
.kiw-box-surface {
  background: var(--bg-2, #f2ede4);
  color: var(--fg, #1c1917);
}
.kiw-box-primary {
  background: var(--primary, #10b981);
  color: var(--primary-content, #1c1917);
}
.kiw-box-card {
  background: var(--bg, #fafaf9);
  color: var(--fg, #1c1917);
  border: 1px solid var(--border-subtle, var(--border));
  border-radius: var(--radius, 10px);
  box-shadow: var(--shadow-sm, 0 1px 2px 0 rgba(11, 31, 59, 0.05));
  padding: 1.25rem;
}
</style>
