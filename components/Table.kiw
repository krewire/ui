<div class="kiw-table-wrapper {class}" class:is-bordered={bordered} {#if id}id="{id}"{/if} data-kiw-component="Table">
  <table class="kiw-table" class:is-striped={striped} class:is-hover={hover}>
    {#if headers}
      <thead>
        <tr>
          {#each headers as h}
            <th>{h}</th>
          {/each}
        </tr>
      </thead>
    {/if}
    {#if rows}
      <tbody>
        {#each rows as row}
          <tr>
            {#each row as cell}
              <td>{cell}</td>
            {/each}
          </tr>
        {/each}
      </tbody>
    {:else}
      {body}
    {/if}
  </table>
</div>

<style>
.kiw-table-wrapper {
  width: 100%;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
  border-radius: var(--radius, 10px);
  box-sizing: border-box;
}
.kiw-table-wrapper.is-bordered {
  border: var(--pop-border-thin, 2px solid var(--border, #0B1F3B));
  box-shadow: var(--pop-sm, 2px 2px 0px var(--border, #0B1F3B));
}
.kiw-table {
  width: 100%;
  border-collapse: collapse;
  text-align: left;
  font-size: 0.85rem;
  color: var(--fg, #0B1F3B);
  background: var(--bg, #FAF8F4);
}
.kiw-table th {
  padding: 0.55rem 0.75rem;
  font-weight: 800;
  text-transform: uppercase;
  font-size: 0.72rem;
  letter-spacing: 0.05em;
  background: var(--bg-2, #f2ede4);
  border-bottom: var(--pop-border-thin, 2px solid var(--border, #0B1F3B));
  white-space: nowrap;
}
.kiw-table td {
  padding: 0.6rem 0.75rem;
  border-bottom: 1px solid var(--border, #0B1F3B);
}
@media (min-width: 640px) {
  .kiw-table {
    font-size: 0.9rem;
  }
  .kiw-table th {
    padding: 0.7rem 1rem;
    font-size: 0.75rem;
  }
  .kiw-table td {
    padding: 0.75rem 1rem;
  }
}
@media (min-width: 1024px) {
  .kiw-table th {
    padding: 0.85rem 1.25rem;
  }
  .kiw-table td {
    padding: 0.85rem 1.25rem;
  }
}
.kiw-table tr:last-child td {
  border-bottom: none;
}
.kiw-table.is-striped tbody tr:nth-child(even) {
  background: var(--bg-2, #f2ede4);
}
.kiw-table.is-hover tbody tr:hover {
  background: rgba(57, 211, 83, 0.08);
}
</style>
