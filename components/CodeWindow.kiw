<div class="code-window {class}" {#if id}id="{id}"{/if} data-kiw-component="CodeWindow">
  <div class="code-window-bar">
    <div class="code-window-dots" aria-hidden="true">
      <span class="code-window-dot dot-red"></span>
      <span class="code-window-dot dot-yellow"></span>
      <span class="code-window-dot dot-green"></span>
    </div>
    <span class="code-window-title font-mono">{#if title}{title}{:else}terminal{/if}</span>
    {#if actions}
      {actions}
    {:else if !hideCopy}
      <button type="button" class="btn-copy-code" aria-label="Copy code to clipboard" onclick="copyCodeWindow(this)">Copy</button>
    {/if}
  </div>
  <pre class="code-window-pre"><code class="code-window-code">{#if body}{body}{:else if code}{code}{:else if showDefaultSample}<span class="c"># Terminal Shell</span>
<span class="p">$ </span><span>echo "Hello, world!"</span>{:else}<span class="c">// Application Entry Point</span>
<span class="k">package</span> main

<span class="k">import</span> (
    <span class="s">"fmt"</span>
)

<span class="k">func</span> <span class="f">main</span>() {
    fmt.Println(<span class="s">"Hello, World!"</span>)
}{/if}</code></pre>
</div>

<style>
.code-window {
  background: #1c1917;
  color: #fafaf9;
  border-radius: var(--radius, 12px);
  overflow: hidden;
  box-shadow: var(--pop-shadow-lg, 0 10px 15px -3px rgba(0, 0, 0, 0.08), 0 4px 6px -4px rgba(0, 0, 0, 0.03));
  border: var(--pop-border, 1px solid var(--border, #e2ded4));
  max-width: 100%;
  min-width: 0;
  width: 100%;
  box-sizing: border-box;
}
html[data-theme="dark"] .code-window {
  background: #071426;
  border-color: #fafaf9;
  box-shadow: 6px 6px 0px #10b981;
}
.code-window-bar {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 8px 12px;
  background: #112646;
  border-bottom: 2px solid var(--border, #1c1917);
}
@media (min-width: 640px) {
  .code-window-bar {
    padding: 10px 15px;
  }
}
@media (min-width: 1024px) {
  .code-window-bar {
    padding: 12px 18px;
  }
}
html[data-theme="dark"] .code-window-bar {
  background: #1c1917;
  border-bottom-color: #fafaf9;
}
.code-window-dots {
  display: flex;
  gap: 6px;
  align-items: center;
}
.code-window-dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  border: 1px solid rgba(0,0,0,0.3);
  display: inline-block;
}
.dot-red { background: #FF3B2E; }
.dot-yellow { background: #ffbd2e; }
.dot-green { background: #10b981; }
.code-window-title {
  margin-left: 10px;
  font-size: 0.75rem;
  font-weight: 700;
  color: #8fa2bc;
  letter-spacing: 0.05em;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.btn-copy-code {
  margin-left: auto;
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  font-size: 11px;
  font-weight: 800;
  padding: 3px 9px;
  border-radius: 6px;
  background: rgba(255, 255, 255, 0.08);
  color: #fafaf9;
  border: 1px solid rgba(255, 255, 255, 0.2);
  cursor: pointer;
  transition: all 0.15s ease;
  line-height: 1.4;
  flex-shrink: 0;
}
.btn-copy-code:hover {
  background: var(--primary, #10b981);
  color: var(--primary-content, #1c1917);
  border-color: var(--primary, #10b981);
  transform: translateY(-1px);
}
.btn-copy-code:active {
  transform: translate(0, 0);
}
.code-window-pre {
  margin: 0;
  padding: 12px 14px;
  overflow-x: auto;
  line-height: 1.65;
}
@media (min-width: 640px) {
  .code-window-pre {
    padding: 15px 18px;
  }
}
@media (min-width: 1024px) {
  .code-window-pre {
    padding: 18px 24px;
  }
}
.code-window-code {
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  font-size: 0.82rem;
  font-weight: 600;
  white-space: pre;
  display: block;
}
.code-window .c { color: #8fa2bc; font-style: italic; }
.code-window .k { color: #00D1C1; font-weight: 700; }
.code-window .t { color: #10b981; font-weight: 700; }
.code-window .s { color: #ffbd2e; }
.code-window .f { color: #60a5fa; font-weight: 700; }
.code-window .n { color: #f472b6; font-weight: 600; }
.code-window .p { color: #8fa2bc; user-select: none; }
.btn-copy-code.copied {
  background: var(--primary, #10b981) !important;
  color: var(--primary-content, #1c1917) !important;
  border-color: var(--primary, #10b981) !important;
}
</style>

<script>
function copyCodeWindow(btn) {
  var win = btn.closest('.code-window');
  var code = win ? win.querySelector('code') : null;
  var text = (code ? code.innerText : '').replace(/\n$/, '');
  var orig = btn.innerText;
  function showCopied() {
    btn.innerText = '✓ Copied!';
    btn.classList.add('copied');
    setTimeout(function() {
      btn.innerText = orig;
      btn.classList.remove('copied');
    }, 2000);
  }
  if (navigator.clipboard && window.isSecureContext) {
    navigator.clipboard.writeText(text).then(showCopied).catch(function() {
      fallbackCopyText(text, showCopied);
    });
  } else {
    fallbackCopyText(text, showCopied);
  }
}
function fallbackCopyText(text, cb) {
  try {
    var ta = document.createElement('textarea');
    ta.value = text;
    ta.style.position = 'fixed';
    ta.style.left = '-9999px';
    document.body.appendChild(ta);
    ta.focus();
    ta.select();
    document.execCommand('copy');
    document.body.removeChild(ta);
    if (cb) cb();
  } catch (err) {}
}
window.copyCodeWindow = copyCodeWindow;
</script>
